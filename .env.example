# Mini E-Commerce — shared environment variables
# Copy to .env and fill in real values. Real .env files are never committed.

# --- PostgreSQL (single instance for all services) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mini_ecommerce

# --- Database (host tooling connects via the compose-published port 5433) ---
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/mini_ecommerce

# --- Redis (cache only; local compose in dev, Upstash rediss:// URL in production) ---
REDIS_URL=redis://localhost:6380

# --- Upstash QStash (event bus) ---
QSTASH_TOKEN=change-me
QSTASH_CURRENT_SIGNING_KEY=change-me
QSTASH_NEXT_SIGNING_KEY=change-me

# --- Authentication (NestJS API) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Seed (admin user created by prisma db seed) ---
ADMIN_EMAIL=admin@miniecommerce.dev
ADMIN_PASSWORD=change-me

# --- Storefront (Next.js server-side API client; never exposed to the browser) ---
API_BASE_URL=http://localhost:3001

# --- Inventory (Go service; own database on the same Postgres instance) ---
# Host tooling connects via the same compose-published port 5433 as DATABASE_URL,
# targeting the separate mini_ecommerce_inventory database.
INVENTORY_DATABASE_URL=postgresql://postgres:change-me@localhost:5433/mini_ecommerce_inventory
# Shared secret required on every inventory endpoint except /health.
INTERNAL_API_KEY=change-me
# Full external URL QStash delivers the order.created webhook to; must match
# exactly what QStash was told to deliver to when verifying its signature.
QSTASH_DESTINATION_URL=http://localhost:8081/internal/v1/events/qstash

# --- Payment (Spring Boot service; own database on the same Postgres instance) ---
# JDBC URL — host tooling connects via the same compose-published port 5433
# as DATABASE_URL, targeting the separate mini_ecommerce_payment database.
PAYMENT_DATABASE_URL=jdbc:postgresql://localhost:5433/mini_ecommerce_payment?user=postgres&password=change-me
# Distinct shared secret from inventory's INTERNAL_API_KEY — each service maps
# its own host variable onto the same in-app INTERNAL_API_KEY name.
PAYMENT_INTERNAL_API_KEY=change-me
# Fraction of simulated charges the payment gateway approves (0.0-1.0).
PAYMENT_GATEWAY_SUCCESS_RATE=0.9
# Full external URL QStash delivers payment's order.created webhook to;
# distinct from inventory's QSTASH_DESTINATION_URL since each service has its
# own webhook URL, even though both share the same QStash account/signing keys.
PAYMENT_QSTASH_DESTINATION_URL=http://localhost:8082/internal/v1/events/qstash

# --- API (NestJS; own inbound QStash webhook, distinct from inventory's/payment's) ---
# Full external URL QStash delivers apps/api's own payment.completed/payment.failed
# webhook to; verified against the signed request's url claim the same way
# inventory/payment already do.
API_QSTASH_DESTINATION_URL=http://localhost:3001/api/v1/events/qstash
# Comma-separated allow-list of origins apps/api accepts CORS requests from.
# Compose doesn't need this set (admin/api share an origin through nginx there);
# only local `ng serve` (Angular dev server on its own port) needs it, e.g.:
# CORS_ORIGINS=http://localhost:4200
CORS_ORIGINS=
# Base URL apps/api uses to call apps/inventory's internal REST endpoints
# (the admin panel's stock-management proxy). apps/inventory publishes no
# host port, so this only resolves inside the compose network -- there is no
# working host-dev value; run apps/api inside compose (or via
# `docker compose up -d --wait api`) to exercise this feature locally.
INVENTORY_BASE_URL=http://inventory:8081
# Must match apps/inventory's own INTERNAL_API_KEY value -- apps/api is a
# trusted caller of apps/inventory's internal endpoints, authenticated the
# same way apps/inventory already expects.
INVENTORY_INTERNAL_API_KEY=change-me

# --- Event publisher mode (apps/api, apps/inventory, apps/payment) ---
# Selects which EventPublisher adapter each service wires at startup:
# "fake" (default) -- an in-memory recorder, no network calls, safe for
# compose/dev/CI, and what every phase's automated verification depends on.
# "real" -- the QStash-backed adapter each service already built; requires
# real QSTASH_TOKEN/QSTASH_CURRENT_SIGNING_KEY/QSTASH_NEXT_SIGNING_KEY values
# and a publicly reachable destination URL for QStash to deliver to (see
# docs/manual-verification/real-event-flow.md). Any value other than "real"
# is treated as "fake" -- never silently default to real.
EVENT_PUBLISHER_MODE=fake
