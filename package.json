{
  "name": "mini-e-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio e-commerce monorepo demonstrating Clean Architecture and event-driven design across Next.js, Angular, NestJS, Go, and Spring Boot",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@mini-e-commerce/config": "workspace:*",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "turbo": "^2.10.4"
  }
}
