{
  "name": "@mini-e-commerce/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI components for the monorepo frontends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@mini-e-commerce/config": "workspace:*",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "react": "^19.2.7",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
